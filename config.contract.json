{
  "schema_version": 1,
  "repository_kind": "skill",
  "configuration": "settings",
  "rationale": "Native configuration controls selected runtime resources and private state; storage discovery alone cannot establish readiness.",
  "documentation": [
    "README.md"
  ],
  "settings": {
    "schema_document": "README.md",
    "discovery_document": "README.md",
    "environment": "SCHEDULE_REMINDER_CONFIG",
    "aliases": [
      "AGENT_CENTER_CONFIG"
    ],
    "precedence": [
      "explicit --config registry file / initializer --out root",
      "AGENT_CENTER_CONFIG selects registry file independently",
      "SCHEDULE_REMINDER_CONFIG selects companion root; unset fails as uninitialized",
      "SCHEDULE_REMINDER_DATA_DIR only selects runtime DATA"
    ],
    "required_fields": [
      "streams"
    ],
    "initializer": {
      "path": "tools/init_config.py",
      "args": [
        "--out",
        "{output}"
      ]
    },
    "doctor": {
      "path": "tools/verify_config.py",
      "args": [
        "--json"
      ]
    }
  }
}
